# Copia este archivo a ".env" (mismo directorio) y completa los valores reales.
# Puerto de este BFF
SERVER_PORT=8087

# Microsoft Entra ID (App Registration de Athenet)
TENANT_ID={tenantId}
CLIENT_ID={clientId}

# Origenes del frontend, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL microservicios
API_EVENTS_URL=http://localhost:8081
